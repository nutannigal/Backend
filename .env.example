PORT=5000

# MongoDB Atlas connection string
# URL-encode special characters in the username or password.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/interiorDB?retryWrites=true&w=majority

# JWT secret
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer
EMAIL_USER=
EMAIL_PASS=
